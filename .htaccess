# Force Apache to load index.html as the primary homepage
DirectoryIndex index.html index.php

# Force correct MIME type for fonts
AddType font/ttf .ttf
AddType font/otf .otf

# Allow cross-origin font loading for all browsers
<FilesMatch "\.(ttf|otf|woff|woff2)$">
    Header set Access-Control-Allow-Origin "*"
</FilesMatch>
